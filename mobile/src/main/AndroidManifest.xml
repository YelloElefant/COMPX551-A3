<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Companion">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The Data Layer wakes this service up when the watch sends something.
          The <data> filter is the bit everyone gets wrong: scheme MUST be "wear",
          host MUST be "*", and pathPrefix must actually prefix your paths.
          Both of our paths start with /sensor, so one filter covers both.
        -->
        <service
            android:name=".data.PhoneWearableListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/sensor" />
            </intent-filter>
        </service>

    </application>
</manifest>
